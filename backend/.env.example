# ---------------------------------------------------------------------------
# MedHelp backend configuration
# Copy this file to `backend/.env` and fill in the values.
# The .env file is git-ignored: never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) ------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# --- JWT -------------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Access token lifetime in minutes, refresh token lifetime in days.
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# --- File storage ----------------------------------------------------------
# STORAGE_PROVIDER = local | supabase
# local    -> files written to STORAGE_LOCAL_PATH, served only through the
#             authenticated backend endpoint /api/documents/{id}/content
# supabase -> files written to a PRIVATE Supabase Storage bucket and read back
#             with short-lived signed URLs
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

# Required only when STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=medical-documents
SUPABASE_SIGNED_URL_SECONDS=300

# --- Server / CORS ---------------------------------------------------------
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Demo seed data --------------------------------------------------------
# Set to true once to create demo patient/doctor accounts with fake data.
SEED_DEMO_DATA=true
